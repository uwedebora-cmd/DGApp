{
  "expo": {
    "name": "DebShop",
    "slug": "debshop",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "debshop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo.png",
      "bundleIdentifier": "com.debshop.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.debshop.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C14",
          "image": "./assets/splash.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1d7ed467-e7c2-4428-80b6-1ea987e25223"
      }
    }
  }
}
